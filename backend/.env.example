APP_NAME=Nogalix
APP_ENV=local
# Set APP_DEBUG=false in production (hides /docs and detailed errors)
APP_DEBUG=true
# Un seul serveur : le site et l'API sont servis sur la même adresse.
APP_URL=http://localhost:8010
FRONTEND_URL=http://localhost:8010
# Origines autorisées (CSRF / CORS) — 3000 = serveur de développement Vite (npm run dev)
FRONTEND_URLS=http://localhost:8010,http://127.0.0.1:8010,http://localhost:3000,http://127.0.0.1:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nogalix
DB_USERNAME=root
DB_PASSWORD=

# Opaque token TTL (minutes) — style Sanctum
AUTH_TOKEN_TTL_MINUTES=1440

# Client OAuth « Web » : origines JavaScript autorisées = http://localhost:8010 (local) et https://<domaine> (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (inutilisé : connexion Google via GSI côté navigateur)
GOOGLE_REDIRECT_URI=

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=nogalix

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@nogalix.avexsolution.com
MAIL_FROM_NAME=Nogalix
CONTACT_TO_EMAIL=contact@nogalix.avexsolution.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=false
GEMINI_MAX_OUTPUT_TOKENS=512

ASSISTANT_NAME=Noga

# E-mails promus admin lors de la connexion Google (e-mail vérifié). Sinon : python scripts/create_admin.py <email>
ADMIN_EMAILS=

# ONLYOFFICE Document Server (Word-like editing for imported CVs)
# Run: docker compose -f docker-compose.onlyoffice.yml up -d
ONLYOFFICE_URL=http://localhost:8082
ONLYOFFICE_JWT_SECRET=
# URL reachable FROM the OnlyOffice container (host API)
APP_INTERNAL_URL=http://host.docker.internal:8010
IMPORT_ACCESS_SECRET=

# Adzuna - offres d'emploi (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr

# RapidAPI - JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com
JSEARCH_COUNTRY=fr

# MeSomb — paiement Mobile Money MTN / Orange (https://business.mesomb.com)
# Webhook à déclarer dans le dashboard MeSomb : https://<domaine>/api/payments/webhook
MESOMB_API_BASE_URL=https://mesomb.hachther.com
MESOMB_API_KEY=
MESOMB_API_SECRET=
MESOMB_APPLICATION_KEY=
# auto : Bearer si la clé commence par sk_, sinon HMAC-SHA1 (comme le SDK / CBC)
MESOMB_AUTH=hmac
MESOMB_LANGUAGE=fr
MESOMB_LOCALE=fr
MESOMB_TIMEOUT=60
MESOMB_CONNECT_TIMEOUT=15
MESOMB_COUNTRY=CM
MESOMB_CURRENCY=XAF
MESOMB_COLLECT_MODE=asynchronous
MESOMB_WEBHOOK_SECRET=
MESOMB_WEBHOOK_URL=
YEARLY_DISCOUNT_PERCENT=20

# KeyPay / MasterKey — paiement par carte (CARD / Stripe). Ne pas utiliser pour MTN/Orange.
# Webhook (prod) : https://<domaine>/api/payments/keypay/webhook
KEYPAY_API_BASE_URL=https://keypay-api.masterkeycm.com
KEYPAY_API_KEY=
KEYPAY_API_SECRET=
KEYPAY_ENVIRONMENT=SANDBOX
KEYPAY_CURRENCY=XAF
KEYPAY_WEBHOOK_SECRET=
KEYPAY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Site web (servi par ce même serveur, voir app/web)
# ---------------------------------------------------------------------------
# Dossier du site compilé (vide = ../frontend/dist)
WEB_DIST_DIR=
# Cookie de session « Secure » : true/false (vide = seulement en production)
AUTH_COOKIE_SECURE=
# Valeurs publiques transmises au navigateur
APP_SHORT_NAME=Nogalix
ASSISTANT_FIRST_NAME=Noga
TURNSTILE_SITE_KEY=
PUBLIC_CONTACT_EMAIL=
SUPPORT_EMAIL=
CONTACT_PHONE=
CBC_NAME=CBC
CBC_URL=https://contactsbusinesscenter.com
# Connexion « Se connecter avec CBC » (local)
CBC_SSO_CLIENT_ID=nogalix-local
CBC_SSO_CLIENT_SECRET=
CBC_SSO_URL=http://localhost:3000
CBC_SSO_API_URL=http://127.0.0.1:8000
PUBLIC_ADMIN_EMAILS=
