# ------------------------------------------------------------------
# Nogalix — variables de production (copier en ./.env à la racine)
# Toutes les valeurs marquées « requis » doivent être renseignées.
# ------------------------------------------------------------------

# Domaine public (sans https://) — requis
APP_DOMAIN=nogalix.avexsolution.com
ACME_EMAIL=contact@avexsolution.com
APP_NAME=Nogalix
APP_URL=https://nogalix.avexsolution.com
FRONTEND_URL=https://nogalix.avexsolution.com
FRONTEND_URLS=https://nogalix.avexsolution.com

# Base de données — requis (mots de passe forts)
DB_DATABASE=nogalix
DB_USERNAME=nogalix
DB_PASSWORD=
DB_ROOT_PASSWORD=

AUTH_TOKEN_TTL_MINUTES=1440

# Secret HMAC des liens d'import (OnlyOffice) — requis : openssl rand -hex 32
IMPORT_ACCESS_SECRET=

# Google Sign-In — origine JavaScript autorisée dans Google Cloud : https://<APP_DOMAIN>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Promus admin à leur connexion Google (e-mail vérifié par Google)
ADMIN_EMAILS=

# Cloudinary (avatars, audio) — sinon stockage local dans le volume backend_storage
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=nogalix

# SMTP (reset de mot de passe, reçus de paiement, formulaire de contact) — requis
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@nogalix.avexsolution.com
MAIL_FROM_NAME=Nogalix
CONTACT_TO_EMAIL=contact@nogalix.avexsolution.com

# IA (assistant, analyse, candidature, traduction, transcription)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true
GEMINI_MAX_OUTPUT_TOKENS=512
ASSISTANT_NAME=Noga

# Offres d'emploi
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr
RAPIDAPI_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com
JSEARCH_COUNTRY=fr

# MeSomb — paiement Mobile Money (https://business.mesomb.com) — requis pour vendre
# Créez une application dédiée à Nogalix dans le dashboard MeSomb, puis :
#   - Webhook URL : https://<APP_DOMAIN>/api/payments/webhook
MESOMB_API_BASE_URL=https://mesomb.hachther.com
MESOMB_API_KEY=
MESOMB_API_SECRET=
MESOMB_APPLICATION_KEY=
# auto : Bearer si la clé commence par sk_, sinon HMAC-SHA1 (comme le SDK / CBC)
MESOMB_AUTH=hmac
MESOMB_LANGUAGE=fr
MESOMB_LOCALE=fr
MESOMB_TIMEOUT=60
MESOMB_CONNECT_TIMEOUT=15
MESOMB_COUNTRY=CM
MESOMB_CURRENCY=XAF
MESOMB_COLLECT_MODE=asynchronous
MESOMB_WEBHOOK_SECRET=
MESOMB_WEBHOOK_URL=
YEARLY_DISCOUNT_PERCENT=20

# OnlyOffice (optionnel : docker compose --profile onlyoffice up -d)
# Laisser ONLYOFFICE_URL vide si le profil onlyoffice n'est pas déployé (éditeur intégré utilisé).
OFFICE_DOMAIN=office-nogalix.avexsolution.com
ONLYOFFICE_URL=
ONLYOFFICE_JWT_SECRET=

# Site web — valeurs publiques transmises au navigateur par le serveur (aucun build à refaire).
APP_SHORT_NAME=Nogalix
ASSISTANT_FIRST_NAME=Noga
TURNSTILE_SITE_KEY=
# E-mail de contact affiché sur le site (défaut : CONTACT_TO_EMAIL)
PUBLIC_CONTACT_EMAIL=
SUPPORT_EMAIL=
CONTACT_PHONE=
CBC_NAME=CBC
CBC_URL=https://contactsbusinesscenter.com
# Connexion « Se connecter avec CBC » : même id/secret que l'entrée « nogalix » de SSO_CLIENTS côté CBC
CBC_SSO_CLIENT_ID=nogalix
CBC_SSO_CLIENT_SECRET=
CBC_SSO_URL=https://contactsbusinesscenter.com
CBC_SSO_API_URL=https://api.contactsbusinesscenter.com
# E-mails affichés comme admin dans l'interface en attendant le rôle en base (optionnel)
PUBLIC_ADMIN_EMAILS=
# Cookie de session « Secure » : vide = actif en production (HTTPS)
AUTH_COOKIE_SECURE=

WEB_CONCURRENCY=2
